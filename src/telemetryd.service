[Unit]
Description=virtual machine telemetry JSON exporter
Documentation=https://github.com/your-repo
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/local/bin/telemetryd.sh

Restart=always
RestartSec=3

# security fixes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/www/telemetry

[Install]
WantedBy=multi-user.target
